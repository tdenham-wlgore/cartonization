include README.md CHANGELOG.md constraints.txt
include .gitignore .gitattributes
recursive-include docs *.md
recursive-include tools *.py
recursive-include tests *.py
recursive-include examples *.py *.json *.xlsx
include data/reference_test_data.xlsx data/shipment_history_test_data.xlsx
include .github/copilot-instructions.md
include .github/workflows/ci.yml
include .vscode/extensions.json .vscode/settings.json
global-exclude __pycache__ *.py[cod] .DS_Store
